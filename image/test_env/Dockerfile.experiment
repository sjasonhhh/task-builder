FROM denoland/deno:bin-2.9.4@sha256:25675bd2a125b59bdcfbb6592ec5c332a2bc56e0dabf038184d8b2c6aec45c3b AS deno

FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_INDEX_URL=https://pypi.org/simple/ \
    PIP_NO_CACHE_DIR=1 \
    PIP_DEFAULT_TIMEOUT=600 \
    PIP_RETRIES=10 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

RUN if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i \
            -e 's|http://deb.debian.org/debian-security|http://mirrors.i.h.pjlab.org.cn/repository/debian-security-proxy|g' \
            -e 's|http://deb.debian.org/debian|http://mirrors.i.h.pjlab.org.cn/repository/debian-proxy|g' \
            -e 's|http://security.debian.org/debian-security|http://mirrors.i.h.pjlab.org.cn/repository/debian-security-proxy|g' \
            /etc/apt/sources.list.d/debian.sources; \
    fi; \
    if [ -f /etc/apt/sources.list ]; then \
        sed -i \
            -e 's|http://deb.debian.org/debian-security|http://mirrors.i.h.pjlab.org.cn/repository/debian-security-proxy|g' \
            -e 's|http://deb.debian.org/debian|http://mirrors.i.h.pjlab.org.cn/repository/debian-proxy|g' \
            -e 's|http://security.debian.org/debian-security|http://mirrors.i.h.pjlab.org.cn/repository/debian-security-proxy|g' \
            /etc/apt/sources.list; \
    fi; \
    for source in /etc/apt/sources.list.d/*.list; do \
        [ -f "$source" ] || continue; \
        sed -i \
            -e 's|http://deb.debian.org/debian-security|http://mirrors.i.h.pjlab.org.cn/repository/debian-security-proxy|g' \
            -e 's|http://deb.debian.org/debian|http://mirrors.i.h.pjlab.org.cn/repository/debian-proxy|g' \
            -e 's|http://security.debian.org/debian-security|http://mirrors.i.h.pjlab.org.cn/repository/debian-security-proxy|g' \
            "$source"; \
    done

RUN apt-get -o Acquire::Retries=3 update \
    && apt-get install -y --no-install-recommends \
        bash \
        bcftools \
        bedtools \
        build-essential \
        ca-certificates \
        curl \
        ffmpeg \
        git \
        jq \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libsm6 \
        libxext6 \
        libxrender1 \
        r-base-core \
        r-bioc-edger \
        samtools \
        tabix \
        tar \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /root/.cache

RUN python -m pip install --no-cache-dir \
        --upgrade \
        pip==24.2 \
        setuptools==79.0.1 \
        wheel==0.46.3

# CUDA 12.1 版 torch：CUDA 运行库随 nvidia-* wheel 安装，GPU 节点只需宿主机驱动。
RUN python -m pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu121 \
        torch==2.4.1 \
        torchvision==0.19.1

COPY requirements-experiment.txt /tmp/requirements-experiment.txt
RUN python -m pip install --no-cache-dir --prefer-binary \
        -r /tmp/requirements-experiment.txt \
    && rm -f /tmp/requirements-experiment.txt

COPY --from=deno /deno /usr/local/bin/deno

WORKDIR /workspace
RUN mkdir -p /workspace /app/results /logs/verifier
