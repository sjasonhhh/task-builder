# Reuse the published CNS experiment environment and add evaluation tools.
ARG BASE_IMAGE=registry.h.pjlab.org.cn/ailab-datatools-data_tools_gpu_pool/shaoyuting@sha256:031d03bfdb4108e5e70a40cfe58b7764a7dee15191f0108ba698801f007d5d92
FROM ${BASE_IMAGE}
USER root

RUN if ! dpkg-query -W -f='${Status}' libseccomp2 2>/dev/null | grep -Fx 'install ok installed'; then \
        apt-get -o Acquire::Retries=3 update \
        && apt-get install -y --no-install-recommends libseccomp2 \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*; \
    fi

COPY requirements-evaluation.txt /opt/cns/requirements-evaluation.txt
RUN python -m pip freeze --all > /tmp/base-constraints.txt \
    && python -m pip install --no-cache-dir --only-binary=:all: \
        -c /tmp/base-constraints.txt -r /opt/cns/requirements-evaluation.txt \
    && python -m pip check \
    && rm /tmp/base-constraints.txt \
    && mkdir -p /tests /app/results /logs/verifier \
    && claude --version && tmux -V && deno --version

WORKDIR /tests
CMD ["bash"]
