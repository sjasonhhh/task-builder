+    def _recover_unhandled_trial_result(
+        self,
+        trial_config: TrialConfig,
+        exception: BaseException,
+    ) -> TrialResult:
+        """Keep one unhandled trial failure from aborting the whole job.
+
+        Most failures are already converted to a TrialResult by Trial.run().
+        This fallback covers failures before a Trial exists and failures raised
+        by cleanup or hooks after Trial.run() has started.  A result written by
+        the trial is preferred so that its verifier output and logs are kept.
+        """
+        result_path = TrialPaths(
+            trial_config.trials_dir / trial_config.trial_name
+        ).result_path
+        if result_path.exists():
+            try:
+                result = TrialResult.model_validate_json(result_path.read_text())
+                self._logger.warning(
+                    "Isolated trial failure for %s after result was written: %s",
+                    trial_config.trial_name,
+                    type(exception).__name__,
+                )
+                return result
+            except Exception as read_error:
+                self._logger.warning(
+                    "Could not read partial result for isolated trial %s: %s",
+                    trial_config.trial_name,
+                    read_error,
+                )
+
+        now = datetime.now(timezone.utc)
+        try:
+            task_id = trial_config.task.get_task_id()
+            task_name = task_id.get_name()
+        except Exception:
+            task_id = trial_config.task.get_task_id()
+            task_name = str(task_id)
+
+        agent_name = (
