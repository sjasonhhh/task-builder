# Only source code, reproducible environment definitions and examples are published.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/setup_env.sh
!/run.sh
!/run_task.sh
!/task_builder/
!/patches/
!/config/
/config/*
!/config/rubric.md
!/config/pricing.toml
!/config/*.example
!/relay/
/relay/*
!/relay/relay.py
!/relay/chat_compat.py
!/relay/config.example.json
!/image/
/image/*
!/image/single-cell/
/image/*/*
!/image/*/Dockerfile.*
!/image/*/requirements-*.txt
!/image/*/README.md
!/image/*/image-env.toml.example
!/scripts/
/scripts/*
!/scripts/start_worker.sh
__pycache__/
*.pyc
.pytest_cache/
*.log

*.env
*.pem
*.key
